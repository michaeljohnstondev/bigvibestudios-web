{
  "hosting": {
    "target": "bvs-web",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/theyo",
        "destination": "/theyo.html"
      },
      {
        "source": "/theyo/join",
        "destination": "/theyo.html"
      },
      {
        "source": "/theyo/invite/**",
        "destination": "/theyo/invite/index.html"
      },
      {
        "source": "/theyo/u/**",
        "destination": "/theyo/u/index.html"
      },
      {
        "source": "/theyo/promo/**",
        "destination": "/theyo/promo/index.html"
      }
    ]
  }
}
